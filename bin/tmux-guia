#!/usr/bin/env bash
# tmux-guia — abre el mapa de atajos y la guía de este repo
# (docs/CHEATSHEET.md seguido de docs/GUIA.md).
# ./install tmux la enlaza en ~/.local/opt/tmux-config/bin (en el PATH solo dentro
# de tmux). Alt+h la abre en una ventana flotante.
set -euo pipefail

docs="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../docs"

if command -v less >/dev/null; then
    # Sin LESSCHARSET, con locale C (servidores mínimos) less toma el texto por binario
    cat "$docs/CHEATSHEET.md" "$docs/GUIA.md" |
        LESSCHARSET=utf-8 less -Ps'tmux-guia · flechas y RePág/AvPág para moverte · /texto busca · q sale'
else
    cat "$docs/CHEATSHEET.md" "$docs/GUIA.md"
fi
